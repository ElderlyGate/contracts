{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ElderlyGate/contracts/apiversion/v1/forms.schema.json",
  "title": "apiVersion forms",
  "description": "Every apiVersion form: one row per current form, with the old forms it replaces and its kinds.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "forms"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*/v[0-9]+$"
    },
    "kind": {
      "const": "ApiVersionForms"
    },
    "forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "new",
          "app",
          "kinds",
          "note"
        ],
        "properties": {
          "new": {
            "description": "<org>/<app>/<family>/v<n>: the family names what holds the files, usually the folder or collection they live in (design, board, queue, log, servers); the kind names one item in it. An app's answers keep the family app.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*/[a-z][a-z0-9-]*/v[0-9]+$"
          },
          "old": {
            "description": "The old forms this one replaces, <level>/<name>/<version> as written before. A reader that meets an old form finds the row whose old list holds it.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*/v[0-9]+$"
            }
          },
          "app": {
            "description": "The product ID of the app that owns the shape.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kinds": {
            "description": "The kinds written with this form. \"*\" stands for every kind the design's Definitions declare, so a design's kinds are open.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^([A-Z][A-Za-z0-9]*|\\*)$"
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "upgrade": {
            "description": "For a row with old forms: hubman migrate <app> <folder>.",
            "type": "string",
            "pattern": "^hubman migrate [a-z][a-z0-9-]* <folder>$"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "old"
              ]
            },
            "then": {
              "required": [
                "upgrade"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "upgrade"
                ]
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
