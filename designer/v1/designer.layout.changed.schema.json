{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ElderlyGate/contracts/designer/v1/designer.layout.changed.schema.json",
  "title": "layout changed",
  "description": "Card positions of a view were saved.",
  "allOf": [
    {
      "$ref": "../../event/v1/event.schema.json"
    },
    {
      "properties": {
        "source": {
          "pattern": "^/designer/[A-Za-z0-9._-]+$"
        },
        "type": {
          "const": "designer.layout.changed"
        },
        "data": {
          "type": "object",
          "required": [
            "design",
            "view"
          ],
          "properties": {
            "design": {
              "type": "string"
            },
            "view": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
