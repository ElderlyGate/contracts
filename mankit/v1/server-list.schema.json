{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ElderlyGate/contracts/mankit/v1/server-list.schema.json",
  "title": "server list",
  "description": "What servers answers with -o json: every server on this machine and whether it answered just now.",
  "allOf": [
    {
      "$ref": "../../envelope/v1/envelope.schema.json"
    },
    {
      "properties": {
        "kind": {
          "const": "ServerList"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "record",
              "answering"
            ],
            "properties": {
              "record": {
                "$ref": "server.schema.json"
              },
              "answering": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
