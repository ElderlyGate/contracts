              "kind": "Adr",
              "metadata": {
                "id": "ADR-001",
                "title": "The ledger is a file, not a database"
              },
              "spec": {
                "state": {
                  "status": "decided"
                },
                "decided": "2026-03-02",
                "source": {
                  "where": [
                    "test/fixtures/design/README.md#the-ledger"
                  ]
                },
                "description": "One locker bank writes a few hundred rows a day. A file that can be read\nwith `less` beats a database nobody has credentials for at 3am, and the\nappend-only rule is enforced by the filesystem rather than by a trigger\nsomebody can drop.\n"
              }
            }
          }
        ],
