        "Design": [
          {
            "kind": "Design",
            "id": "default",
            "path": "design.yml",
            "changedAt": 1794566861444,
            "document": {
              "apiVersion": "elderlygate/designer/design/v2",
              "kind": "Design",
              "metadata": {
                "id": "default",
                "title": "A parcel locker"
              },
              "spec": {
                "description": "**A worked example, small enough to read in one sitting.**\n\nThree blocks, one flow, one saved request and one suite — a person\ndrops a parcel into a locker and the ledger learns about it.\n\nNothing here is a real system. What is real is the *shape*: every file in\nthis design is byte-for-byte what the emitter renders, which is what makes\nthe directory usable as a fixture as well as an example.\n",
                "board": {
                  "links": {
                    "calls": {
                      "color": "#7d8794",
                      "dashed": false
                    },
                    "related": {
                      "color": "#a1668a",
                      "dashed": true
                    }
                  }
                },
                "implementation": {
                  "root": "."
                }
              }
            }
          }
        ],
        "Flow": [
          {
            "kind": "Flow",
            "id": "drop-a-parcel",
            "path": "flow/drop-a-parcel.yml",
            "changedAt": 1794566861446,
            "document": {
              "apiVersion": "elderlygate/designer/design/v2",
              "kind": "Flow",
              "metadata": {
                "id": "drop-a-parcel",
                "title": "Drop a parcel"
              },
              "spec": {
                "entry": {
                  "method": "POST",
                  "path": "/v1/parcels"
                },
                "before": {
                  "CMP-LOCKS": {
                    "doors.open": 0
                  },
                  "CMP-LEDGER": {
                    "rows": 0
                  }
                },
                "steps": [
                  {
                    "id": "person",
                    "at": "CMP-KIOSK",
                    "phase": "caller",
                    "label": "Somebody scans a barcode",
                    "note": "The only actor. Everything after this is the locker answering one question — which door."
                  },
                  {
                    "id": "pick",
                    "at": "CMP-LOCKS",
                    "phase": "execute",
                    "label": "Choose a free door",
                    "budgetMs": 50,
                    "components": {
                      "CMP-LOCKS": {
                        "doors.open": 1
                      }
                    },
                    "findings": {
                      "RSK-001": "The step that picks one door is the step a fail-open would turn into all of them."
                    }
                  },
                  {
                    "id": "write",
                    "at": "CMP-LEDGER",
                    "phase": "execute",
                    "label": "Append the row",
                    "budgetMs": 10,
                    "components": {
                      "CMP-LEDGER": {
                        "rows": 1
                      }
                    },
                    "note": "Written before the door opens: a row with no parcel behind it is recoverable, a parcel with no row is not."
                  },
                  {
                    "id": "open",
                    "at": "CMP-LOCKS",
                    "phase": "return",
                    "label": "The door opens"
                  }
                ]
              }
            }
          }
        ],
