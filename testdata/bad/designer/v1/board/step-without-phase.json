            "document": {
              "apiVersion": "elderlygate/designer/design/v2",
              "kind": "Block",
              "metadata": {
                "id": "CMP-KIOSK",
                "title": "The kiosk",
                "tags": [
                  "edge",
                  "touched-by-a-person"
                ]
              },
              "spec": {
                "place": {
                  "group": "GRP-EDGE",
                  "role": "adapter"
                },
                "state": {
                  "status": "decided"
                },
                "code": {
                  "service": "locker.kiosk",
                  "implements": "kiosk/main.go"
                },
                "source": {
                  "where": [
                    "test/fixtures/design/README.md#the-edge"
                  ]
                },
                "description": "The only block a person touches. It knows a door number and a parcel\nbarcode, and nothing else — no addresses, no names, no ledger.\n\n🟢 That narrowness is the point: the kiosk is the block most likely to\nbe replaced, and the one with least to carry over when it is.\n"
              }
            }
          },
          {
            "kind": "Block",
            "id": "CMP-LEDGER",
            "path": "block/CMP-LEDGER.yml",
            "changedAt": 1794566861445,
            "document": {
              "apiVersion": "elderlygate/designer/design/v2",
              "kind": "Block",
              "metadata": {
                "id": "CMP-LEDGER",
                "title": "The ledger",
                "tags": [
                  "append-only"
                ]
              },
              "spec": {
                "place": {
                  "group": "GRP-CORE",
                  "role": "handler"
                },
                "state": {
                  "status": "decided"
                },
                "code": {
                  "service": "locker.ledger",
                  "implements": "internal/ledger/log.go#Log"
                },
                "description": "Append-only. A parcel that went in and never came out is a row that has no\npartner, and finding those is the whole reason the ledger exists rather\nthan a `parcels` table with a `collected` column.\n"
              }
            }
          },
          {
            "kind": "Block",
            "id": "CMP-LOCKS",
            "path": "block/CMP-LOCKS.yml",
            "changedAt": 1794566861445,
            "document": {
              "apiVersion": "elderlygate/designer/design/v2",
              "kind": "Block",
              "metadata": {
                "id": "CMP-LOCKS",
                "title": "The lock controller"
              },
              "spec": {
                "place": {
                  "group": "GRP-CORE",
                  "role": "handler"
                },
                "state": {
                  "status": "open"
                },
                "code": {
                  "service": "locker.locks",
                  "implements": "internal/locks/controller.go#Controller"
                },
                "description": "Opens one door at a time and refuses to open a second while the first is\nstill ajar.\n\nThe refusal is the interesting half. A door that will not open is a\ncomplaint somebody makes; a bank of doors all open at once is a story in\nthe local paper.\n"
              }
            }
          }
