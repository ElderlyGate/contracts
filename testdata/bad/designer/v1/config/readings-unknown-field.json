    "rules": [
      {
        "id": "groups-quiet",
        "description": "Every group is drawn quietly.",
        "given": {
          "kind": "Group"
        },
        "when": "*",
        "then": {
          "styles": "quiet"
        },
        "source": "built-in"
      },
      {
        "id": "later-is-planned",
        "description": "A part of a later release is drawn as planned.",
        "given": {
          "kind": "Block"
        },
        "when": {
          "release": [
            "beta",
            "later"
          ]
        },
        "then": {
          "styles": [
            "planned"
          ]
        },
        "source": "design"
      },
      {
        "id": "decided-is-ticked",
        "description": "A decided thing is ticked.",
        "given": "*",
        "when": {
          "status": "decided"
        },
        "then": {
          "styles": "ticked"
        },
        "source": "built-in"
      },
      {
        "id": "kitchen-in-lagoon",
        "description": "The kitchen group stands out.",
        "given": {
          "kind": "Group",
          "group": "GRP-KITCHEN"
        },
        "when": "*",
        "then": {
          "styles": [
            "quiet",
            "lagoon"
          ]
        },
        "source": "design"
      },
      {
        "id": "just-changed",
        "description": "What a write just changed is lit up.",
        "given": "*",
        "when": {
          "event": "designer.board.changed"
        },
        "then": {
          "styles": {
            "border-color": "accent",
            "border-width": "thick"
          },
          "for": "3s"
        },
        "source": "built-in"
      },
      {
        "id": "selected-stands-out",
        "description": "A selected thing stands out.",
        "given": "*",
        "when": {
          "action": "selected"
        },
        "then": {},
        "source": "design"
      }
