    "metadata": {
      "id": "drop-a-parcel",
      "title": "Drop a parcel"
    },
    "spec": {
      "entry": {
        "method": "POST",
        "path": "/v1/parcels"
      },
      "before": {
        "CMP-LOCKS": {
          "doors.open": 0
        },
        "CMP-LEDGER": {
          "rows": 0
        }
      },
      "steps": [
        {
          "id": "person",
          "at": "CMP-KIOSK",
          "phase": "caller",
          "label": "Somebody scans a barcode",
          "note": "The only actor. Everything after this is the locker answering one question \u2014 which door."
        },
        {
          "id": "pick",
          "at": "CMP-LOCKS",
          "phase": "execute",
          "label": "Choose a free door",
          "budgetMs": 50,
          "components": {
            "CMP-LOCKS": {
              "doors.open": 1
            }
          },
          "findings": {
            "RSK-001": "The step that picks one door is the step a fail-open would turn into all of them."
          }
        },
        {
          "id": "write",
          "at": "CMP-LEDGER",
          "phase": "execute",
          "label": "Append the row",
          "budgetMs": 10,
          "components": {
            "CMP-LEDGER": {
              "rows": 1
            }
          },
          "note": "Written before the door opens: a row with no parcel behind it is recoverable, a parcel with no row is not."
        },
        {
          "id": "open",
          "at": "CMP-LOCKS",
          "phase": "return",
          "label": "The door opens"
        }
      ]
    }
  },
