              "metadata": {
                "id": "drop-a-parcel",
                "title": "Drop a parcel"
              },
              "spec": {
                "before": {
                  "CMP-LEDGER": {
                    "rows": 0
                  },
                  "CMP-LOCKS": {
                    "doors.open": 0
